---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description || "Cybersecurity guide by TheCyberNews"}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <div class="mb-8">
      {frontmatter.category && (
        <span class="text-blue-600 font-semibold tracking-wider uppercase text-sm mb-2 block">
          {frontmatter.category}
        </span>
      )}
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
        {frontmatter.title}
      </h1>
      {frontmatter.date && (
        <p class="text-slate-500 text-sm">Last updated: {new Date(frontmatter.date).toLocaleDateString()}</p>
      )}
    </div>
    
    <article class="prose prose-slate prose-lg lg:prose-xl max-w-none prose-a:text-blue-600 hover:prose-a:text-blue-500 prose-img:rounded-xl prose-img:shadow-md">
      <slot />
    </article>
  </div>
</Layout>

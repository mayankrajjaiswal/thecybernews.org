---
import '../styles/global.css';
import GlobalSearch from '../components/GlobalSearch';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { 
  title, 
  description,
  image = '/default-social-card.png' // You will need to add this image to /public later
} = Astro.props;

// Construct full canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://thecybernews.org');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === 'Home' ? 'TheCyberNews | The Practical Cybersecurity Knowledge Platform' : `${title} | TheCyberNews`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | TheCyberNews`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | TheCyberNews`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Add standard favicon later -->
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased flex flex-col min-h-screen">
    <header class="bg-white shadow-sm border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8">
        <a href="/" class="text-2xl font-bold tracking-tight text-blue-700 flex-shrink-0">
          TheCyberNews
        </a>
        <div class="flex-grow max-w-xl">
          <GlobalSearch client:idle />
        </div>
        <nav class="hidden lg:flex items-center space-x-4 flex-shrink-0 text-sm">
          <a href="/learn" class="text-slate-600 hover:text-blue-600 font-medium">Learn Cyber</a>
          <a href="/scams" class="text-slate-600 hover:text-blue-600 font-medium">Scam Alerts</a>
          <a href="/dictionary" class="text-slate-600 hover:text-blue-600 font-medium">Dictionary</a>
          <a href="/tools" class="text-slate-600 hover:text-blue-600 font-medium">Toolbox</a>
          <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <a href="/saved" class="text-emerald-700 hover:text-emerald-800 font-bold bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-100 transition-colors whitespace-nowrap">My Saved Guides</a>
            <a href="/academy" class="text-indigo-700 hover:text-indigo-800 font-bold bg-indigo-50 px-3 py-1.5 rounded-full border border-indigo-100 transition-colors whitespace-nowrap">Academy Dashboard</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-300 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h3 class="text-white font-bold text-lg mb-4">TheCyberNews.org</h3>
          <p class="text-sm">The world's most practical cybersecurity knowledge platform — helping everyone stay safe online through trusted guides and plain English.</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Pillars</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/learn" class="hover:text-white transition-colors">Zero to Hero</a></li>
            <li><a href="/scams" class="hover:text-white transition-colors">Latest Scams</a></li>
            <li><a href="/dictionary" class="hover:text-white transition-colors">Cyber Dictionary</a></li>
            <li><a href="/news" class="hover:text-white transition-colors">News Explained</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4">Extras</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/academy" class="hover:text-white transition-colors text-indigo-400 font-semibold">Academy Dashboard</a></li>
            <li><a href="/tools" class="hover:text-white transition-colors">Cyber Toolbox</a></li>
            <li><a href="/downloads" class="hover:text-white transition-colors">Downloads Hub</a></li>
            <li><a href="/resources" class="hover:text-white transition-colors">Curated Resources</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-700 text-sm text-center">
        &copy; {new Date().getFullYear()} TheCyberNews.org. All rights reserved.
      </div>
    </footer>
  </body>
</html>

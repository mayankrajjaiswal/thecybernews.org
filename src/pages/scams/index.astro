---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allScams = await getCollection('scams');

// Sort by date (if available) or by severity logic
const scams = allScams.sort((a, b) => {
  // Simple fallback sort by title if no date exists
  return a.data.title.localeCompare(b.data.title);
});

const urgencyColors: Record<string, string> = {
  Critical: 'bg-red-100 text-red-800 border-red-200',
  High: 'bg-orange-100 text-orange-800 border-orange-200',
  Medium: 'bg-yellow-100 text-yellow-800 border-yellow-200',
  Low: 'bg-emerald-100 text-emerald-800 border-emerald-200',
};
---

<Layout title="Scam Alerts" description="Tactical teardowns of active fraud schemes and how to avoid them.">
  <div class="bg-red-50 py-16 border-b border-red-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-red-900 tracking-tight mb-4">
        Active Scam Alerts
      </h1>
      <p class="text-xl text-red-800 max-w-2xl mx-auto">
        Learn exactly how modern scams work, see real screenshots, and find out what to do if you're targeted.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {scams.map((scam) => (
        <a href={`/scams/${scam.id}`} class="block bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow group">
          <div class="flex justify-between items-start mb-4">
            <span class="text-sm font-semibold text-slate-500 uppercase tracking-wider">{scam.data.category}</span>
            <span class={`text-xs px-2.5 py-1 rounded-full font-bold border ${urgencyColors[scam.data.severity || 'Medium']}`}>
              {scam.data.severity || 'Medium'} Alert
            </span>
          </div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">
            {scam.data.title}
          </h2>
          <p class="text-slate-600 leading-relaxed mb-4 line-clamp-3">
            {scam.data.description}
          </p>
          <div class="flex items-center text-blue-600 font-semibold text-sm">
            Read Teardown &rarr;
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

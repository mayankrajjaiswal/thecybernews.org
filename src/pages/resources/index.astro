---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allResources = await getCollection('resources');

const typeColors: Record<string, string> = {
  Government: 'bg-blue-100 text-blue-800 border-blue-200',
  Community: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  Framework: 'bg-purple-100 text-purple-800 border-purple-200',
  Corporate: 'bg-slate-100 text-slate-800 border-slate-200',
};
---

<Layout title="Curated Resources" description="Trusted external organizations, databases, and frameworks for cybersecurity.">
  <div class="bg-slate-900 py-16 border-b border-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        Curated Resources
      </h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto">
        A directory of trusted organizations, official government agencies, and community databases.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allResources.map((resource) => (
        <a href={`/resources/${resource.id}`} class="block bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col h-full group">
          <div class="flex justify-between items-start mb-4">
            <span class={`text-xs px-2.5 py-1 rounded-full font-bold border ${typeColors[resource.data.type] || typeColors.Corporate}`}>
              {resource.data.type}
            </span>
          </div>
          <h2 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">
            {resource.data.title}
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6 flex-grow">
            {resource.data.description}
          </p>
          <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-auto">
            <span class="text-blue-600 font-semibold text-sm">Read Summary &rarr;</span>
            <span class="text-slate-400 group-hover:text-slate-600 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import SavedItemsList from '../components/SavedItemsList';
---

<Layout title="My Saved Guides" description="Access your personal, locally saved reading list.">
  <div class="bg-indigo-900 py-16 border-b border-indigo-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-indigo-300 font-bold uppercase tracking-wider text-sm mb-4 block">Personal Library</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        My Saved Guides
      </h1>
      <p class="text-xl text-indigo-200 max-w-2xl mx-auto">
        Your personal reading list. Saved securely on your device without needing an account.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 min-h-[50vh]">
    <SavedItemsList client:only="react" />
  </div>
</Layout>

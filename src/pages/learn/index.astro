---
import Layout from '../../layouts/Layout.astro';

// In the future, this can be dynamically generated by fetching all markdown files
const levels = [
  {
    title: 'Beginner: Cyber Hygiene Basics',
    description: 'Start here. The absolute essentials to protect your digital life.',
    modules: [
      { title: 'The Power of Password Managers', href: '/learn/passwords', readTime: '5 min' },
      { title: 'Turning on MFA (Multi-Factor Auth)', href: '/learn/mfa', readTime: '4 min' },
      { title: 'How to Spot a Phishing Email', href: '/learn/phishing-basics', readTime: '6 min' },
    ]
  },
  {
    title: 'Intermediate: Securing Your Environment',
    description: 'Lock down your home, mobile devices, and physical presence.',
    modules: [
      { title: 'Securing Your Home Wi-Fi', href: '/learn/home-wifi', readTime: '7 min' },
      { title: 'Mobile Device Hardening', href: '/learn/mobile-security', readTime: '8 min' },
      { title: 'Safe Online Banking & Shopping', href: '/learn/safe-banking', readTime: '5 min' },
    ]
  },
  {
    title: 'Advanced: Privacy & Footprint',
    description: 'Take control of your data and understand advanced threats.',
    modules: [
      { title: 'Managing Your Digital Footprint', href: '/learn/digital-footprint', readTime: '10 min' },
      { title: 'Understanding VPNs and Proxies', href: '/learn/vpns', readTime: '6 min' },
      { title: 'Ransomware: How to Protect Your Data', href: '/learn/ransomware', readTime: '8 min' },
    ]
  }
];
---

<Layout title="Zero to Hero Learning Path" description="A structured path from absolute beginner to cybersecurity confident.">
  <div class="bg-blue-50 py-16 border-b border-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 tracking-tight mb-4">
        Zero to Hero
      </h1>
      <p class="text-xl text-blue-800 max-w-2xl mx-auto">
        No technical jargon. Just clear, step-by-step guides to mastering your personal cybersecurity.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">Explore by Topic Hub</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {['Identity Security', 'Network Security', 'Digital Privacy', 'Family Safety', 'Threat Defense', 'Workplace Security'].map(hub => (
          <a href={`/learn/hub/${hub.toLowerCase().replace(/\s+/g, '-')}`} class="bg-white border border-slate-200 rounded-xl p-6 text-center shadow-sm hover:border-blue-400 hover:shadow-md hover:-translate-y-1 transition-all group">
            <span class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">{hub}</span>
          </a>
        ))}
      </div>
    </div>
    
    <div class="border-t border-slate-200 pt-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">The Structured Path</h2>
      <div class="space-y-16">
      {levels.map((level, index) => (
        <div class="relative">
          {/* Connector line for the timeline effect */}
          {index !== levels.length - 1 && (
            <div class="hidden md:block absolute left-8 top-24 bottom-[-4rem] w-0.5 bg-blue-200"></div>
          )}
          
          <div class="flex flex-col md:flex-row gap-6 md:gap-8">
            <div class="hidden md:flex flex-shrink-0 w-16 h-16 rounded-full bg-blue-600 text-white items-center justify-center text-2xl font-bold z-10 relative shadow-md">
              {index + 1}
            </div>
            
            <div class="flex-grow">
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">{level.title}</h2>
              <p class="text-lg text-slate-600 mb-6">{level.description}</p>
              
              <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <ul class="divide-y divide-slate-100">
                  {level.modules.map(mod => (
                    <li>
                      <a href={mod.href} class="block p-5 hover:bg-slate-50 transition-colors group">
                        <div class="flex items-center justify-between">
                          <div class="flex items-center">
                            <svg class="w-5 h-5 text-blue-400 mr-3 group-hover:text-blue-600 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-lg font-medium text-slate-800 group-hover:text-blue-600 transition-colors">{mod.title}</span>
                          </div>
                          <div class="flex items-center text-slate-400 text-sm">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            {mod.readTime}
                          </div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      ))}
      </div>
    </div>
  </div>
</Layout>

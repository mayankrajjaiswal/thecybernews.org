---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Zero to Hero Learning Path" description="A structured path from absolute beginner to cybersecurity confident.">
  <div class="bg-blue-50 py-16 border-b border-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 tracking-tight mb-4">
        Zero to Hero
      </h1>
      <p class="text-xl text-blue-800 max-w-2xl mx-auto">
        No technical jargon. Just clear, step-by-step guides to mastering your personal cybersecurity.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">Explore by Topic Hub</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {['Identity Security', 'Network Security', 'Digital Privacy', 'Family Safety', 'Threat Defense', 'Workplace Security'].map(hub => (
          <a href={`/learn/hub/${hub.toLowerCase().replace(/\s+/g, '-')}`} class="bg-white border border-slate-200 rounded-xl p-6 text-center shadow-sm hover:border-blue-400 hover:shadow-md hover:-translate-y-1 transition-all group">
            <span class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">{hub}</span>
          </a>
        ))}
      </div>
    </div>
    
    <div class="border-t border-slate-200 pt-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">Guided Roadmaps</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { id: 'beginners', title: 'Cyber Security for Beginners', desc: 'The absolute essentials. Start here if you are overwhelmed.' },
          { id: 'small-business', title: 'Small Business Security', desc: 'Protect your company data, train employees, and defend against ransomware.' },
          { id: 'family', title: 'Home & Family Internet Safety', desc: 'Lock down your Wi-Fi and protect your children online.' }
        ].map(roadmap => (
          <a href={`/roadmaps/${roadmap.id}`} class="block bg-slate-50 border border-slate-200 rounded-2xl p-8 hover:border-indigo-400 hover:shadow-lg transition-all group">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-indigo-700 transition-colors">{roadmap.title}</h3>
            <p class="text-slate-600 mb-6">{roadmap.desc}</p>
            <span class="text-indigo-600 font-semibold inline-flex items-center">
              Start Roadmap &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

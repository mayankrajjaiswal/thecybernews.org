---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLearnDocs = await getCollection('learn');
  
  // Extract all unique subcategories from the markdown frontmatter
  const subcategories = [...new Set(
    allLearnDocs
      .map(doc => doc.data.subcategory)
      .filter(Boolean) // Remove undefined
  )];

  return subcategories.map(subcat => ({
    params: { topic: subcat?.toLowerCase().replace(/\s+/g, '-') },
    props: { 
      topicName: subcat,
      // Pass only the docs that belong to this specific topic
      guides: allLearnDocs.filter(doc => doc.data.subcategory === subcat) 
    },
  }));
}

const { topicName, guides } = Astro.props;
---

<Layout title={`${topicName} Hub`} description={`Everything you need to know about ${topicName}.`}>
  <div class="bg-blue-900 py-16 border-b border-blue-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-blue-300 font-bold uppercase tracking-wider text-sm mb-4 block">Knowledge Hub</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        {topicName}
      </h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        Curated guides and tutorials to master {topicName} step-by-step.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {guides.map(guide => (
        <a href={`/learn/${guide.id}`} class="block bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all group">
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2 block">{guide.data.difficulty || 'All Levels'}</span>
          <h2 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">{guide.data.title}</h2>
          <p class="text-slate-600 mb-4 line-clamp-3">{guide.data.description}</p>
          <div class="flex justify-between items-center mt-auto pt-4 border-t border-slate-100">
            <span class="text-sm font-medium text-slate-500">{guide.data.readingTime || '5 min read'}</span>
            <span class="text-blue-600 font-semibold text-sm">Read Guide &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

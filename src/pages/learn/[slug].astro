---
import { getCollection, render } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';

export async function getStaticPaths() {
  const allLearnDocs = await getCollection('learn');
  return allLearnDocs.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Feature 13: Internal Linking Engine implementation 
// Fetch other random guides to keep user engaged (in a real app, match by tags)
const allDocs = await getCollection('learn');
const relatedGuides = allDocs.filter(doc => doc.id !== entry.id).slice(0, 3);
---

<MarkdownLayout frontmatter={entry.data}>
  {/* The Content component automatically renders the markdown body here */}
  <Content />

  {/* Feature 18: Related Content Blocks */}
  <div class="mt-16 pt-8 border-t border-slate-200 not-prose">
    <h3 class="text-2xl font-bold text-slate-900 mb-6">Continue Learning</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedGuides.map(guide => (
        <a href={`/learn/${guide.id}`} class="block bg-slate-50 rounded-xl p-5 border border-slate-200 hover:border-blue-300 hover:shadow-sm transition-all group">
          <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2 block">{guide.data.category}</span>
          <h4 class="font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">{guide.data.title}</h4>
          <p class="text-sm text-slate-600 line-clamp-2">{guide.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</MarkdownLayout>

---
import Layout from '../../layouts/Layout.astro';

const newsArticles = [
  {
    title: 'The "Mother of All Breaches" (MOAB)',
    date: 'August 1, 2026',
    description: 'A massive database containing billions of leaked passwords was discovered online. Here is what you need to know.',
    href: '/news/moab-breach-explained',
    impactLevel: 'High',
  },
  {
    title: 'Apple Releases Emergency iPhone Update',
    date: 'July 28, 2026',
    description: 'Apple pushed a surprise update to fix a "Zero-Day" flaw. Find out if your phone is affected.',
    href: '/news/apple-emergency-update',
    impactLevel: 'Medium',
  },
  {
    title: 'New Federal Laws on Smart Home Devices',
    date: 'July 15, 2026',
    description: 'New regulations will force manufacturers to stop using default passwords like "admin".',
    href: '/news/smart-home-laws',
    impactLevel: 'Low',
  }
];

const impactColors = {
  High: 'bg-red-100 text-red-800',
  Medium: 'bg-yellow-100 text-yellow-800',
  Low: 'bg-emerald-100 text-emerald-800',
};
---

<Layout title="News Explained" description="Cybersecurity news translated into plain English. No jargon, just what you need to know.">
  <div class="bg-slate-800 py-16 border-b border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        News, Explained.
      </h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto">
        We don't publish "breaking news." We decode complex security events and tell you exactly what to do about them.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-8">
      {newsArticles.map((article) => (
        <article class="bg-white rounded-2xl p-6 md:p-8 border border-slate-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
          {/* Accent border based on impact */}
          <div class={`absolute top-0 left-0 w-1.5 h-full ${
            article.impactLevel === 'High' ? 'bg-red-500' :
            article.impactLevel === 'Medium' ? 'bg-yellow-500' : 'bg-emerald-500'
          }`}></div>
          
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
            <time class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2 md:mb-0">
              {article.date}
            </time>
            <span class={`text-xs px-3 py-1 rounded-full font-bold ${impactColors[article.impactLevel]}`}>
              Impact: {article.impactLevel}
            </span>
          </div>
          
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-3">
            <a href={article.href} class="hover:text-blue-600 transition-colors">
              {article.title}
            </a>
          </h2>
          
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            {article.description}
          </p>
          
          <a href={article.href} class="inline-flex items-center font-semibold text-blue-600 hover:text-blue-700">
            Read the 5-Minute Breakdown
            <svg class="w-5 h-5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>

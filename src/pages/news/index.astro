---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');

// Sort by date descending (newest first)
const newsArticles = allNews.sort((a, b) => {
  const dateA = a.data.lastUpdated || a.data.date || new Date().toISOString();
  const dateB = b.data.lastUpdated || b.data.date || new Date().toISOString();
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});

const impactColors: Record<string, string> = {
  High: 'bg-red-100 text-red-800',
  Medium: 'bg-yellow-100 text-yellow-800',
  Low: 'bg-emerald-100 text-emerald-800',
};
---

<Layout title="News Explained" description="Cybersecurity news translated into plain English. No jargon, just what you need to know.">
  <div class="bg-slate-800 py-16 border-b border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        News, Explained.
      </h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto">
        We don't publish "breaking news." We decode complex security events and tell you exactly what to do about them.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-8">
      {newsArticles.map((article) => (
        <article class="bg-white rounded-2xl p-6 md:p-8 border border-slate-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
          {/* Accent border based on impact */}
          <div class={`absolute top-0 left-0 w-1.5 h-full ${
            article.data.impactLevel === 'High' ? 'bg-red-500' :
            article.data.impactLevel === 'Medium' ? 'bg-yellow-500' : 'bg-emerald-500'
          }`}></div>
          
          <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
            <time class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2 md:mb-0">
              {new Date(article.data.lastUpdated || article.data.date || Date.now()).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span class={`text-xs px-3 py-1 rounded-full font-bold ${impactColors[article.data.impactLevel || 'Medium']}`}>
              Impact: {article.data.impactLevel || 'Medium'}
            </span>
          </div>
          
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-3">
            <a href={`/news/${article.id}`} class="hover:text-blue-600 transition-colors">
              {article.data.title}
            </a>
          </h2>
          
          <p class="text-slate-600 text-lg leading-relaxed mb-6 line-clamp-3">
            {article.data.description}
          </p>
          
          <a href={`/news/${article.id}`} class="inline-flex items-center font-semibold text-blue-600 hover:text-blue-700">
            Read the 5-Minute Breakdown
            <svg class="w-5 h-5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>

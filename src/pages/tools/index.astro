const downloads = [
  { title: 'The 10-Minute Identity Theft Recovery Guide', size: '1.2 MB PDF' },
  { title: 'Cyber Safety Poster for School Classrooms', size: '3.4 MB PDF' },
  { title: 'Printable Password Cheat Sheet (For Seniors)', size: '800 KB PDF' }
];
---

<Layout title="Cyber Toolbox" description="Free, secure client-side tools and downloadable resources.">
  <div class="bg-indigo-50 py-16 border-b border-indigo-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-indigo-900 tracking-tight mb-4">
        The Cyber Toolbox
      </h1>
      <p class="text-xl text-indigo-800 max-w-2xl mx-auto">
        Free, secure tools that run directly in your browser, plus high-quality cheat sheets you can print.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-slate-900 mb-8">Interactive Utilities</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {tools.map(tool => (
        <a href={tool.href} class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-indigo-400 hover:shadow-md transition-all group">
          <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mb-5 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon}></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">{tool.title}</h3>
          <p class="text-slate-600">{tool.description}</p>
        </a>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-slate-900 mb-8">Downloadable Posters & Checklists</h2>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <ul class="divide-y divide-slate-100">
        {downloads.map(item => (
          <li class="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between hover:bg-slate-50 transition-colors cursor-pointer">
            <div class="flex items-center mb-4 sm:mb-0">
              <svg class="w-8 h-8 text-red-500 mr-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
              </svg>
              <span class="text-lg font-semibold text-slate-800">{item.title}</span>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-sm text-slate-500">{item.size}</span>
              <button class="bg-indigo-50 text-indigo-700 px-4 py-2 rounded-lg font-medium hover:bg-indigo-100 transition-colors">
                Download
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
